# ---- Database ----
POSTGRES_USER=teacherai
POSTGRES_DB=teacherai
POSTGRES_PASSWORD=change-me-long-random

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-64-hex-characters

# ---- Bootstrap administrator (created once, on an empty database) ----
SEED_ADMIN_EMAIL=admin@yourschool.edu
SEED_ADMIN_PASSWORD=change-me-immediately

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
TEXT_MODEL=gpt-4o
CHEAP_TEXT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1

# ---- Platform ----
# Default monthly AI budget per user, in cents of real provider spend. 0 = unmetered.
DEFAULT_MONTHLY_ALLOCATION_CENTS=500
PUBLIC_URL=http://localhost
HTTP_PORT=80
